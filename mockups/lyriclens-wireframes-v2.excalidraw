      "seed": 76419325,
      "version": 1,
      "versionNonce": 430381097,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774354711320,
      "link": null,
      "locked": false,
      "text": "Songs cluster by emotional theme, not genre. Notice how 60s soul and 80s power ballads\nshare a neighbourhood. Keyword search would never connect them — they don't share\nwords, they share feelings. That's what embeddings capture.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Songs cluster by emotional theme, not genre. Notice how 60s soul and 80s power ballads\nshare a neighbourhood. Keyword search would never connect them — they don't share\nwords, they share feelings. That's what embeddings capture.",
      "autoResize": true,
      "lineHeight": 1.25
    },
